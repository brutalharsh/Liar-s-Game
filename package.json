{
  "name": "liars-game",
  "version": "0.1.0",
  "private": true,
  "description": "Liar's Game — browser multiplayer bluffing card game (Liar's Deck format). Original code, art and assets.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web --if-present",
    "dev:server": "npm run dev -w apps/server --if-present",
    "typecheck": "npm run typecheck --if-present --workspaces",
    "lint": "npm run lint --if-present --workspaces",
    "test": "npm run test --if-present --workspaces",
    "verify": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.21.0"
  }
}
