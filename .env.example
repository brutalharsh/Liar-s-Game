# ============================================================
# LIAR'S GAME — environment template
# ------------------------------------------------------------
# Convention (implemented by the config loaders):
#   NODE_ENV=production  →  loads .env.production
#   otherwise (dev)     →  loads .env.local   (falls back to .env)
# Only THIS file is committed. .env.local / .env.production hold REAL
# secrets, are gitignored, and are never referenced from source code.
# Generate secrets with:  openssl rand -hex 32
# Production deploy: .env.production is maintained copy-paste-ready
# for the VPS (see STR/06 §5).
# ============================================================

# --- App ---
APP_URL=http://localhost:3000

# --- Auth (users MUST login to play) ---
AUTH_SECRET=                      # openssl rand -hex 32
DISCORD_CLIENT_ID=                # discord.com/developers/applications → OAuth2
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=                 # console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=
# Redirect URIs (register in both consoles):
#   {APP_URL}/api/auth/discord/callback      (Discord, scope: identify)
#   {APP_URL}/api/auth/google/callback       (Google, scopes: openid email profile)

# --- Admin dashboard (/admindashboard) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=liars-game

# --- Game server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# --- Payments: hosted payment proxy (Razorpay behind it) ---
# Base URL + full API reference: PRIVATE gitignored docs/ folder.
# PAYMENTS_PROVIDER = mock | proxy   (flip to proxy after registration)
PAYMENTS_PROVIDER=mock
PAYMENT_PROXY_URL=                # provider base URL — maintainer supplies
PAYMENT_API_KEY=                  # (after project registration)
PROJECT_ID=                       # (after project registration)
PROJECT_NAME=liars-game

# --- Image server (hosted) ---
# Base URL + full API reference: PRIVATE gitignored docs/ folder.
IMAGE_SERVER_URL=                 # provider base URL — maintainer supplies
IMAGE_SERVER_KEY=                 # this project's OWN key (uploads etc.)
IMAGE_SERVER_PROJECT_ID=
