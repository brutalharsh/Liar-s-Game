# ── Secrets & environment ─────────────────────────────
# Real env files stay on the machine — only the template is committed.
.env*
!.env.example

# ── Private integration references (hosted services) ──
# Full API docs + key recipes for the payment proxy & image server.
# NEVER commit or push this folder.
/docs/

# ── Dependencies ──────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Builds & output ───────────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.next-env.d.ts

# ── Testing ───────────────────────────────────────────
coverage/

# ── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor junk ──────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.pem
*.swp
